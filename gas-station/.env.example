# ============================================
# Service: verisim-gas-station (self-contained)
# No external stack required — dev/test stacks
# bring their own postgres + api + ui.
# Copy to .env and adjust YOUR_* values.
# ============================================

CONF=YOUR_INSTALL_DIR/conf
TZ=America/New_York
IP=YOUR_SERVER_IP
HOMEPAGE_GROUP=Verisim

# Shared DB credentials
VERISIM_POSTGRES_USER=verisim
VERISIM_POSTGRES_PASSWORD=verisim

# Industry DB name (default: gas_station)
VERISIM_GAS_DB=gas_station

# Port offsets from grocery (5499/8010/8501) so both stacks coexist
VERISIM_GAS_POSTGRES_PORT=5500
VERISIM_GAS_API_PORT=8011
VERISIM_GAS_UI_PORT=8502
